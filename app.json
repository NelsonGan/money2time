{
  "expo": {
    "name": "Money2Time",
    "slug": "money2time",
    "scheme": "money2time",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/ios/AppIcon~ios-marketing.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F0",
      "dark": {
        "image": "./assets/splash.png",
        "backgroundColor": "#121A24"
      }
    },
    "ios": {
      "icon": "./assets/ios/AppIcon~ios-marketing.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.nelsongan.money2time",
      "usesIcloudStorage": true,
      "entitlements": {
        "com.apple.developer.kernel.extended-virtual-addressing": true,
        "com.apple.developer.kernel.increased-memory-limit": true,
        "com.apple.developer.icloud-container-identifiers": ["iCloud.com.nelsongan.money2time"],
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.com.nelsongan.money2time"]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Money2Time",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["chatgpt", "claude", "gemini"],
        "NSPhotoLibraryUsageDescription": "Money2Time may access your photo library if you choose to attach an image to a transaction.",
        "BGTaskSchedulerPermittedIdentifiers": ["money2time-auto-backup"],
        "NSUbiquitousContainers": {
          "iCloud.com.nelsongan.money2time": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerSupportedFolderLevels": "Any",
            "NSUbiquitousContainerName": "Money2Time"
          }
        }
      }
    },
    "android": {
      "icon": "./assets/android/play_store_512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "monochromeImage": "./assets/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nelsongan.money2time"
    },
    "web": {
      "favicon": "./assets/android/play_store_512.png"
    },
    "plugins": [
      "./plugins/withGradleMemory",
      "./plugins/withMoney2TimeWidgets",
      "expo-localization",
      "expo-notifications",
      "expo-screen-orientation",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Money2Time uses your microphone to convert your spoken transactions into entries.",
          "speechRecognitionPermission": "Money2Time transcribes your spoken transactions on device, so you can log spending hands-free."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.229377044166-7hkgkf8se5duonne5tgbph71ld6to3pg"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27dec73c-197f-4b74-87ae-542e75fc549e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/27dec73c-197f-4b74-87ae-542e75fc549e"
    }
  }
}
