# Nothing here is a secret, and production needs none of it: the PostHog
# project token and GA4 measurement ID are checked into
# `src/lib/analytics-config.ts`, and the relay URL below defaults to
# production.
#
# Copy what you need to `.env.development.local`, not `.env.local`: Vite
# reads `.env.local` for production builds too, so a local relay URL there
# would be built into a deploy made from this machine.

# The Web Dashboard relay. Defaults to
# https://workers-web-dashboard.money2time.com; point it at a local one
# (`npm run dev` in apps/cloudflare/workers/web-dashboard,
# with http://app.localhost:3000 in its .dev.vars ALLOWED_ORIGINS).
NEXT_PUBLIC_WEB_DASHBOARD_RELAY_URL=

# Overrides the checked-in PostHog project token, for a deployment that
# should report elsewhere.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
