{
  "name": "money2time-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "preview": "vite build && vite preview --port 3000",
    "lint": "eslint",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "deploy": "vinext-cloudflare deploy",
    "deploy:prebuilt": "vinext-cloudflare deploy --skip-build",
    "upload": "cf workers versions create --prebuilt --mode production"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.2.1",
    "next-intl": "^4.13.0",
    "posthog-js": "^1.438.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.5",
    "@next/eslint-plugin-next": "^16.4.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.23",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0"
  },
  "type": "module"
}
