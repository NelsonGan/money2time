# Hashed build output, so it can be cached until the heat death of the universe.
# Every other route's caching is decided by vinext and passed through as-is.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The Web Dashboard's logos, item art and card designs. Not fingerprinted, so a
# day, after which the browser checks back (and gets a 304 if nothing changed).
/dashboard-assets/*
  Cache-Control: public, max-age=86400
