EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxx
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxx
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=your_entitlement_id
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=your_offering_id
# PostHog (analytics, error tracking, session replay, feature flags). The public
# project token is checked into constants/posthog.ts; set this only to point a
# local build at another project. Development builds send nothing unless
# EXPO_PUBLIC_POSTHOG_DEV=1.
# EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxx
# EXPO_PUBLIC_POSTHOG_DEV=1
# Build-time only (EAS secret, never EXPO_PUBLIC_): a PostHog personal API key
# with "error tracking: write" and "organization: read" scopes. When set, the
# build uploads Hermes source maps and native debug symbols so stack traces are
# readable. When unset the build skips the upload.
# POSTHOG_CLI_API_KEY=phx_xxxxx
# POSTHOG_CLI_PROJECT_ID=658608
# Receipt-scan Worker (Cloudflare) base URL — see apps/cloudflare/workers/receipt-scanner. No API key here.
EXPO_PUBLIC_MONEY2TIME_WORKERS_RECEIPT_SCANNER=https://workers-receipt-scanner.money2time.com
# Live-earnings push Worker (Cloudflare) base URL — see apps/cloudflare/workers/live-earnings.
# Unset simply means the Live Activity's amount only refreshes when the app is
# in the foreground, which is where the feature was before the Worker existed.
EXPO_PUBLIC_MONEY2TIME_WORKERS_LIVE_EARNINGS=https://workers-live-earnings.money2time.com
# Shared secret both Workers verify requests with.
EXPO_PUBLIC_REQUEST_SIGNING_KEY=
# Brandfetch — client id (publishable, used in cdn.brandfetch.io logo URLs) and
# API key (secret, server-side Brand API). Onboarding/Share brand logos are
# pre-bundled under assets/brands/social, so these are only needed to refetch
# or add logos (see scripts/fetch-brand-logos.mjs).
EXPO_PUBLIC_BRANDFETCH_CLIENT_ID=your_brandfetch_client_id
BRANDFETCH_API_KEY=your_brandfetch_api_key
