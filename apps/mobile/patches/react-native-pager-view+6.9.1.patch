+// money2time patch: see unmountChildComponentView. Released controllers are let
+// go on the next main-queue turn, after UIPageViewController has finished its
+// own bookkeeping for the scroll or page change that led here.
+- (void)releaseUnmountedPages {
+    NSArray<UIViewController *> *released = [_releasedChildViewControllers copy];
+    [_releasedChildViewControllers removeAllObjects];
+    BOOL resync = _needsPageResyncAfterScroll;
+    _needsPageResyncAfterScroll = NO;
+    if (released.count == 0 && !resync) {
+        return;
+    }
+    __weak RNCPagerViewComponentView *weakSelf = self;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        (void)released;
+        __strong RNCPagerViewComponentView *strongSelf = weakSelf;
+        if (!resync || strongSelf == nil) {
+            return;
+        }
+        NSInteger maxPage = strongSelf->_nativeChildrenViewControllers.count - 1;
+        if (maxPage >= 0) {
+            [strongSelf goTo:MIN(MAX(strongSelf->_currentIndex, 0), maxPage) animated:NO];
+        }
+    });
+}
