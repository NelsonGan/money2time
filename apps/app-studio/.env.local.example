# ── Claude API (for description translation) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Brandfetch (for scripts/fetch-brand-logos.mjs) ───────────────────────────
BRANDFETCH_API_KEY=
BRANDFETCH_CLIENT_ID=

# ── Stores ───────────────────────────────────────────────────────────────────
# Credentials do NOT live here. Uploads run through two CLIs that hold them:
#   asc    App Store Connect key, in the macOS keychain   →  asc auth login
#   gplay  Play service account JSON                      →  gplay auth login
# Check both with `asc doctor` and `gplay doctor`.

# Numeric App ID from App Store Connect, not the bundle id.
ASC_APP_ID=1234567890

ANDROID_PACKAGE_NAME=com.yourapp.package

# Only needed if this app's Play account is not gplay's default profile.
# Register one, then name it here:
#   gplay auth login --service-account ./key.json --profile money2time --set-default=false
# GPLAY_PROFILE=money2time
