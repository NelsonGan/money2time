{
  "name": "money2time-workers-cloud-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker for Cloud Sync: Better Auth sign-in (Apple, Google, email code) on D1, per-user Turso databases for the app's local-first sync, and the user's images in R2.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/resolve-ts.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true
  }
}
