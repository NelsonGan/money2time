EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxx
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxx
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=your_entitlement_id
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=your_offering_id
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token
# Receipt-scan Worker (Cloudflare) base URL — see /cloudflare/workers/receipt-scanner. No API key here; the
# key stays server-side in the Worker. In CI this is set to the branch's Worker
# preview URL so a branch build talks to its own Worker.
EXPO_PUBLIC_MONEY2TIME_WORKERS_RECEIPT_SCANNER=https://workers-receipt-scanner.money2time.com
# Shared secret used to sign requests to the receipt-scan Worker. Set the SAME
# value as the Worker's MONEY2TIME_REQUEST_SIGNING_KEY secret. Leave unset to
# disable signing (the Worker then accepts unsigned requests).
EXPO_PUBLIC_REQUEST_SIGNING_KEY=
