EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxx
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxx
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=your_entitlement_id
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=your_offering_id
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token
# Receipt-scan Worker (Cloudflare) base URL — see /worker. No API key here; the
# key stays server-side in the Worker. In CI this is set to the branch's Worker
# preview URL so a branch build talks to its own Worker.
EXPO_PUBLIC_MONEY2TIME_LLM_WORKER_URL=https://llm.money2time.com
